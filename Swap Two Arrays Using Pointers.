#include <stdio.h>
int main(){
  int n;
  scanf("%d",&n);
  int a[n],b[n];
  int *p1 = a , *p2 = b ;
  for(int i=0;i<n;i++){
    scanf("%d",&*(p1+i));
  }
  for(int i=0;i<n;i++){
    scanf("%d",&*(p2+i));
  }
  for(int i=0;i<n;i++){
    int temp = *(p1+i);
    *(p1+i) = *(p2+i);
    *(p2+i) = temp;
  }
  for(int i=0;i<n;i++){
    printf("%d ",*(p1+i));
  }
  printf("\n");
  for(int i=0;i<n;i++){
    printf("%d ",*(p2+i));
  }
  return 0;
}
